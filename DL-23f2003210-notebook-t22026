    "\n",
    "def ensemble_probs(w1, w2, w3, p_lstm, p_bigru, p_bert):\n",
    "    return w1 * p_lstm + w2 * p_bigru + w3 * p_bert\n",
    "\n",
    "def ensemble_map3(w1, w2, w3):\n",
    "    probs = ensemble_probs(w1, w2, w3, val_probs_lstm, val_probs_bigru, val_probs_bert)\n",
    "    return map_at_3(probs, yval)\n",
    "\n",
    "best_ens_map3, best_weights = -1.0, (1/3, 1/3, 1/3)\n",
    "step = 0.05\n",
    "grid = np.round(np.arange(0.0, 1.0 + 1e-9, step), 2)\n",
    "\n",
    "for w1 in grid:\n",
    "    for w2 in grid:\n",
    "        w3 = round(1.0 - w1 - w2, 2)\n",
    "        if w3 < 0 or w3 > 1.0:\n",
    "            continue\n",
    "        m = ensemble_map3(w1, w2, w3)\n",
    "        if m > best_ens_map3:\n",
    "            best_ens_map3 = m\n",
    "            best_weights = (w1, w2, w3)\n",
    "\n",
    "w1, w2, w3 = best_weights\n",
    "print(\"Best ensemble val MAP@3: %.4f\" % best_ens_map3)\n",
    "print(\"Best weights -> LSTM: %.2f | BiGRU: %.2f | BERT: %.2f\" % (w1, w2, w3))\n",
    "\n",
    "ens_run = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"ensemble_final\",\n",
    "                      job_type=\"eval\", config={\"w_lstm\": w1, \"w_bigru\": w2, \"w_bert\": w3},\n",
    "                      reinit=True)\n",
    "ens_run.summary[\"val_map3\"] = best_ens_map3\n",
    "ens_run.finish()\n"
