    "from transformers import (\n",
    "    AutoTokenizer, AutoModelForMultipleChoice, TrainingArguments, Trainer,\n",
    "    EarlyStoppingCallback,\n",
    ")\n",
    "from datasets import Dataset\n",
    "from dataclasses import dataclass\n",
    "from transformers.tokenization_utils_base import PreTrainedTokenizerBase\n",
    "from typing import Union\n",
    "\n",
    "BERT_MODEL_NAME = \"bert-base-uncased\"\n",
    "BERT_MAX_LEN = 256\n",
    "\n",
    "run_bert = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model3_bert\",\n",
    "                       job_type=\"train\", config={\n",
    "                           \"base_model\": BERT_MODEL_NAME, \"max_len\": BERT_MAX_LEN,\n",
    "                           \"epochs\": 5, \"lr\": 2e-5, \"batch_size\": 8,\n",
    "                           \"grad_accum_steps\": 2, \"warmup_ratio\": 0.1, \"weight_decay\": 0.01,\n",
    "                       }, reinit=True)\n",
    "cfg_bert = run_bert.config\n",
    "\n",
    "bert_tok = AutoTokenizer.from_pretrained(cfg_bert.base_model)\n",
    "\n",
    "def to_mc_features(df, has_label=True):\n",
    "    first_sentences = [[p] * 5 for p in df['prompt']]\n",
    "    second_sentences = [[df.iloc[i][opt] for opt in OPTS] for i in range(len(df))]\n",
    "    first_sentences = sum(first_sentences, [])\n",
    "    second_sentences = sum(second_sentences, [])\n",
    "    tokenized = bert_tok(first_sentences, second_sentences, truncation=True,\n",
    "                          max_length=cfg_bert.max_len, padding=False)\n",
    "    features = {k: [v[i:i + 5] for i in range(0, len(v), 5)] for k, v in tokenized.items()}\n",
    "    if has_label:\n",
    "        features['labels'] = df['answer'].map(OPT2IDX).tolist()\n",
    "    return features\n",
    "\n",
    "bert_train_ds = Dataset.from_dict(to_mc_features(tr_df))\n",
    "bert_val_ds   = Dataset.from_dict(to_mc_features(val_df))\n",
    "bert_test_ds  = Dataset.from_dict(to_mc_features(test, has_label=False))\n",
    "\n",
    "@dataclass\n",
    "class DataCollatorForMultipleChoice:\n",
    "    tokenizer: PreTrainedTokenizerBase\n",
    "    padding: Union[bool, str] = True\n",
    "\n",
    "    def __call__(self, features):\n",
    "        label_name = \"labels\" if \"labels\" in features[0] else None\n",
    "        labels = [f.pop(label_name) for f in features] if label_name else None\n",
    "        batch_size = len(features)\n",
    "        num_choices = len(features[0][\"input_ids\"])\n",
    "        flattened = [\n",
    "            {k: v[i] for k, v in f.items()} for f in features for i in range(num_choices)\n",
    "        ]\n",
    "        batch = self.tokenizer.pad(flattened, padding=self.padding, return_tensors=\"pt\")\n",
    "        batch = {k: v.view(batch_size, num_choices, -1) for k, v in batch.items()}\n",
    "        if labels is not None:\n",
    "            batch[\"labels\"] = torch.tensor(labels, dtype=torch.int64)\n",
    "        return batch\n",
    "\n",
    "bert_collator = DataCollatorForMultipleChoice(tokenizer=bert_tok)\n"
