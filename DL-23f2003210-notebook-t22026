ply.started":"2026-07-30T15:44:46.76173Z","shell.execute_reply":"2026-07-30T15:44:46.791015Z"}},"outputs":[{"name":"stdout","text":"1707 293\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":"## 2. MAP@3 Metric","metadata":{}},{"cell_type":"code","source":"\ndef map_at_3(scores, y_true):\n   \n    order = np.argsort(-scores, axis=1)[:, :3]\n    ap = 0.0\n    for i in range(len(y_true)):\n        preds = order[i]\n        hits = np.where(preds == y_true[i])[0]\n        if len(hits):\n            ap += 1.0 / (hits[0] + 1)\n    return ap / len(y_true)\n\ndef top3_labels(scores):\n    order = np.argsort(-scores, axis=1)[:, :3]\n    return [' '.join(OPTS[j] for j in row) for row in order]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T15:44:46.79232Z","iopub.execute_input":"2026-07-30T15:44:46.792595Z","iopub.status.idle":"2026-07-30T15:44:46.801857Z","shell.execute_reply.started":"2026-07-30T15:44:46.792576Z","shell.execute_reply":"2026-07-30T15:44:46.801011Z"}},"outputs":[],"execution_count":6},{"cell_type":"markdown","source":"\n## 3. MODEL 1 — From Scratch: TF-IDF/SVD Embeddings + MLP Scorer\n\n","metadata":{}},{"cell_type":"code","source":"\nrun1 = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model1_scratch_tfidf_mlp\",\n                   job_type=\"train\", config={\"model\": \"tfidf_svd_mlp\", \"svd_dim\": 128,\n                                              \"hidden\": 128, \"epochs\": 30, \"lr\": 1e-3, \"batch_size\": 64})\nconfig = run1.config\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T15:44:46.802744Z","iopub.execute_input":"2026-07-30T15:44:46.803Z","iopub.status.idle":"2026-07-30T15:44:58.108834Z","shell.execute_reply.started":"2026-07-30T15:44:46.802974Z","shell.execute_reply":"2026-07-30T15:44:58.108303Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":""},"metadata":{}},{"output_type"