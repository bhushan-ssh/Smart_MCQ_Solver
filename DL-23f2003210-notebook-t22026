    "def compute_metrics(eval_pred):\n",
    "    logits, labels = eval_pred\n",
    "    scores = torch.softmax(torch.tensor(logits), dim=1).numpy()\n",
    "    m3 = map_at_3(scores, labels)\n",
    "    acc = (scores.argmax(1) == labels).mean()\n",
    "    return {\"map3\": m3, \"accuracy\": acc}\n",
    "\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=\"./model3_ckpt\",\n",
    "    per_device_train_batch_size=cfg3.batch_size,\n",
    "    per_device_eval_batch_size=cfg3.batch_size * 2,\n",
    "    learning_rate=cfg3.lr,\n",
    "    num_train_epochs=cfg3.epochs,\n",
    "    eval_strategy=\"epoch\",\n",
    "    save_strategy=\"epoch\",\n",
    "    load_best_model_at_end=True,\n",
    "    metric_for_best_model=\"map3\",\n",
    "    report_to=\"none\",   # was: \"wandb\" — avoid HF's internal wandb callback closing our run\n",
    "    run_name=\"model3_lora_deberta\",\n",
    "    bf16=torch.cuda.is_available() and torch.cuda.is_bf16_supported(),\n",
    "    fp16=False,\n",
    ")\n",
    "\n",
    "trainer = Trainer(\n",
    "    model=model3,\n",
    "    args=training_args,\n",
    "    train_dataset=train_ds,\n",
