0], \"weights (m1,m2,m3):\", best[1])\nw1, w2, w3 = best[1]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-02T15:23:26.16519Z","iopub.execute_input":"2026-08-02T15:23:26.16602Z","iopub.status.idle":"2026-08-02T15:23:26.258498Z","shell.execute_reply.started":"2026-08-02T15:23:26.165978Z","shell.execute_reply":"2026-08-02T15:23:26.257716Z"}},"outputs":[{"name":"stdout","text":"Best ensemble val MAP@3: 0.6245733788395906 weights (m1,m2,m3): (np.float64(0.7), np.float64(0.2), np.float64(0.1))\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"\nens_run = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"ensemble_final\", job_type=\"eval\",\n                      config={\"w1\": w1, \"w2\": w2, \"w3\": w3})\nens_run.summary[\"val_map3\"] = best[0]\nens_run.finish()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-02T15:23:26.259622Z","iopub.execute_input":"2026-08-02T15:23:26.260338Z","iopub.status.idle":"2026-08-02T15:23:33.624288Z","shell.execute_reply.started":"2026-08-02T15:23:26.260309Z","shell.execute_reply":"2026-08-02T15:23:33.623292Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Tracking run with wandb version 0.28.1"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Run data is saved locally in <code>/kaggle/working/wandb/run-20260802_152326-xzywzca3</code>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Syncing run <strong><a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026/runs/xzywzca3' target=\"_blank\">ensemble_final</a></strong> to <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f