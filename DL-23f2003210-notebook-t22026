 Skipping torchao as it is not installed.\u001b[0m\u001b[33m\n\u001b[0m","output_type":"stream"}],"execution_count":1},{"id":"4c92614d","cell_type":"code","source":"\nimport os, re, json, math\nimport numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.model_selection import train_test_split\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nSEED = 42\nnp.random.seed(SEED); torch.manual_seed(SEED)\nDEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\nprint('Device:', DEVICE)\n\nOPTS = ['A', 'B', 'C', 'D', 'E']\nOPT2IDX = {o: i for i, o in enumerate(OPTS)}\n\nTRAIN_PATH = '/kaggle/input/competitions/smart-mcq-solver-challenge/train.csv'   # <-- update path\nTEST_PATH  = '/kaggle/input/competitions/smart-mcq-solver-challenge/test.csv'    # <-- update path\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:13.121094Z","iopub.execute_input":"2026-07-04T04:48:13.121593Z","iopub.status.idle":"2026-07-04T04:48:16.157492Z","shell.execute_reply.started":"2026-07-04T04:48:13.121563Z","shell.execute_reply":"2026-07-04T04:48:16.156700Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\n","output_type":"stream"}],"execution_count":2},{"id":"a6746329","cell_type":"code","source":"\nimport wandb\nWANDB_PROJECT = \"23f2003210-t22026\"   # <-- update to match your W&B project name\nWANDB_ENTITY  = None                   # <-- your wandb username/team, or leave None\nwandb.login()  # will prompt for API key the first time\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:16.158549Z","iopub.execute_input":"2026-07-04T04:48:16.158939Z","iopub.status.idle":"2026-07-04T04:48:24.711877Z","shell.execute_reply.started":"2026-07-04T04:48:16.158913Z","shell.execute_reply":"2026-07-04T04:48:24.711144Z"}},"outputs":[{"name":"stderr","text":"\u001b[34m\u001b[1mwandb\u001b[0m: [wandb.login()] Loaded credentials for https://api.wandb.ai from /root/.netrc.\n\u001b[34m\u001b[1mwandb\u001b[0m: W&B API key is configured. Use \u001b[1m`wandb login --relogin`\u001b[0m to force relogin\n","output_type":"stream"},{"execution_count":3,"output_type":"execute_result","data":{"text/plain":"True"},"metadata":{}}],"execution_count":3},{"id":"91ea55f1","cell_type":"markdown","source":"## 1. Load & Clean Data","metadata":{}},{"id":"b4137cf0","cell_type":"code","source":"\ntrain = pd.read_csv(TRAIN_PATH)\ntest  = pd.read_csv(TEST_PATH)\n\ndef clean(t):\n    t = re.sub(r'\\s+', ' ', str(t)).strip()\n    return t\n\nfor c in ['prompt'] + OPTS:\n    train[c] = train[c].astype(str).map(clean)\n    test[c]  = test[c].astype(str).map(clean)\n\nprint(train.shape, test.shape)\ntrain.head(2)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:24.713650Z","iopub.execute_input":"2026-07-04T04:48:24.713949Z","iopub.status.idle":"2026-07-04T04:48:24.921297Z","shell.execute_reply.started":"2026-07-04T04:48:24.713907Z","shell.execute_reply":"2026-07-04T04:48:24.920500Z"}},"outputs":[{"name":"stdout","text":"(2000, 8) (500, 7)\n","output_type":"stream"},{"execution_count":4,"output_type":"execute_result","data":{"text/plain":"   id                                             prompt  \\\n0   1  Pick the best possible answer: What is Martin ...   \n1   2        What is accelerator-based light-ion fusion?   \n\n                                                   A  \\\n0  Martin Heidegger believes that humans exist wi...   \n1  Accelerator-based light-ion fusion is a techni...   \n\n                                                   B  \\\n0  Martin Heidegger believes that humans do not e...   \n1  Accelerator-based light-ion fusion is a techni...   \n\n                                                   C  \\\n0  Martin Heidegger does not believe in the exist...   \n1  Accelerator-based light-ion fusion is a techni...   \n\n                                                   D  \\\n0  Martin Heidegger believes that the relationshi...   \n1  Accelerator-based light-ion fusion is a techni...   \n\n                                                   E answer  \n0  Martin Heidegger believes that time is an illu...      B  \n1  Accelerator-based light-ion fusion is a techni...      A  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>id</th>\n      <th>prompt</th>\n      <th>A</th>\n      <th>B</th>\n      <th>C</th>\n      <th>D</th>\n      <th>E</th>\n      <th>answer</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>1</td>\n      <td>Pick the best possible answer: What is Martin ...</td>\n      <td>Martin Heidegger believes that humans exist wi...</td>\n      <td>Martin Heidegger believes that humans do not e...</td>\n      <td>Martin Heidegger does not believe in the exist...</td>\n      <td>Martin Heidegger believes that the relationshi...</td>\n      <td>Martin Heidegger believes that time is an illu...</td>\n      <td>B</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2</td>\n      <td>What is accelerator-based light-ion fusion?</td>\n      <td>Accelerator-based light-ion fusion is a techni...</td>\n      <td>Accelerator-based light-ion fusion is a techni...</td>\n      <td>Accelerator-based light-ion fusion is a techni...</td>\n      <td>Accelerator-based light-ion fusion is a techni...</td>\n      <td>Accelerator-based light-ion fusion is a techni...</td>\n      <td>A</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":4},{"id":"06d63532","cell_type":"code","source":"\n# Held-out validation split (stratified on answer) used to evaluate + select all 3 models fairly\ntr_df, val_df = train_test_split(\n    train, test_size=0.15, random_state=SEED, stratify=train['answer']\n)\nytr  = tr_df['answer'].map(OPT2IDX).values\nyval = val_df['answer'].map(OPT2IDX).values\nprint(len(tr_df), len(val_df))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:24.922356Z","iopub.execute_input":"2026-07-04T04:48:24.922678Z","iopub.status.idle":"2026-07-04T04:48:24.934421Z","shell.execute_reply.started":"2026-07-04T04:48:24.922655Z","shell.execute_reply":"2026-07-04T04:48:24.933602Z"}},"outputs":[{"name":"stdout","text":"1700 300\n","output_type":"stream"}],"execution_count":5},{"id":"2916db3b","cell_type":"markdown","source":"## 2. MAP@3 Metric","metadata":{}},{"id":"e8c5ec06","cell_type":"code","source":"\ndef map_at_3(scores, y_true):\n   \n    order = np.argsort(-scores, axis=1)[:, :3]\n    ap = 0.0\n    for i in range(len(y_true)):\n        preds = order[i]\n        hits = np.where(preds == y_true[i])[0]\n        if len(hits):\n            ap += 1.0 / (hits[0] + 1)\n    return ap / len(y_true)\n\ndef top3_labels(scores):\n    order = np.argsort(-scores, axis=1)[:, :3]\n    return [' '.join(OPTS[j] for j in row) for row in order]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:24.935340Z","iopub.execute_input":"2026-07-04T04:48:24.935716Z","iopub.status.idle":"2026-07-04T04:48:24.947335Z","shell.execute_reply.started":"2026-07-04T04:48:24.935673Z","shell.execute_reply":"2026-07-04T04:48:24.946683Z"}},"outputs":[],"execution_count":6},{"id":"25958a9a","cell_type":"markdown","source":"\n## 3. MODEL 1 — From Scratch: TF-IDF/SVD Embeddings + MLP Scorer\n\nNo pretrained weights anywhere. TF-IDF + SVD gives classical \"embeddings\" (matches Milestone 1),\nand a small MLP (randomly initialised, trained only on this data) scores each option.\n","metadata":{}},{"id":"2a48da84","cell_type":"code","source":"\nrun1 = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model1_scratch_tfidf_mlp\",\n                   job_type=\"train\", config={\"model\": \"tfidf_svd_mlp\", \"svd_dim\": 128,\n                                              \"hidden\": 128, \"epochs\": 30, \"lr\": 1e-3, \"batch_size\": 64})\nconfig = run1.config\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:24.948324Z","iopub.execute_input":"2026-07-04T04:48:24.948866Z","iopub.status.idle":"2026-07-04T04:48:31.471241Z","shell.execute_reply.started":"2026-07-04T04:48:24.948841Z","shell.execute_reply":"2026-07-04T04:48:31.470671Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Tracking run with wandb version 0.28.0"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Run data is saved locally in <code>/kaggle/working/wandb/run-20260704_044825-ipugz7ux</code>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Syncing run <strong><a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026/runs/ipugz7ux' target=\"_blank\">model1_scratch_tfidf_mlp</a></strong> to <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026' target=\"_blank\">Weights & Biases</a> (<a href='https://wandb.me/developer-guide' target=\"_blank\">docs</a>)<br>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":" View project at <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026' target=\"_blank\">https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026</a>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":" View run at <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026/runs/ipugz7ux' target=\"_blank\">https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026/runs/ipugz7ux</a>"},"metadata":{}}],"execution_count":7},{"id":"9406c351","cell_type":"code","source":"\nall_texts = list(tr_df['prompt']) + [t for c in OPTS for t in tr_df[c]]\ntfidf = TfidfVectorizer(max_features=20000, ngram_range=(1, 2), sublinear_tf=True)\ntfidf.fit(all_texts)\n\nsvd = TruncatedSVD(n_components=config.svd_dim, random_state=SEED)\nsvd.fit(tfidf.transform(all_texts))\n\ndef embed(texts):\n    return svd.transform(tfidf.transform(texts))\n\ndef build_features(df):\n    p_emb = embed(df['prompt'].tolist())\n    feats = []\n    for opt in OPTS:\n        o_emb = embed(df[opt].tolist())\n        prod = p_emb * o_emb\n        diff = np.abs(p_emb - o_emb)\n        cos = (p_emb * o_emb).sum(1) / (np.linalg.norm(p_emb, axis=1) * np.linalg.norm(o_emb, axis=1) + 1e-8)\n        feats.append(np.concatenate([p_emb, o_emb, prod, diff, cos[:, None]], axis=1))\n    return np.stack(feats, axis=1)  # (N, 5, F)\n\nXtr  = build_features(tr_df)\nXval = build_features(val_df)\nprint(\"feature shape:\", Xtr.shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:31.472238Z","iopub.execute_input":"2026-07-04T04:48:31.472664Z","iopub.status.idle":"2026-07-04T04:48:34.334488Z","shell.execute_reply.started":"2026-07-04T04:48:31.472640Z","shell.execute_reply":"2026-07-04T04:48:34.333800Z"}},"outputs":[{"name":"stdout","text":"feature shape: (1700, 5, 513)\n","output_type":"stream"}],"execution_count":8},{"id":"599d7ff7","cell_type":"code","source":"\nclass ScratchScorer(nn.Module):\n    def __init__(self, in_dim, hidden=128):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(in_dim, hidden), nn.ReLU(), nn.Dropout(0.3),\n            nn.Linear(hidden, hidden // 2), nn.ReLU(),\n            nn.Linear(hidden // 2, 1),\n        )\n    def forward(self, x):  # (B,5,F)\n        B, K, Fd = x.shape\n        return self.net(x.reshape(B * K, Fd)).reshape(B, K)\n\nmodel1 = ScratchScorer(Xtr.shape[-1], config.hidden).to(DEVICE)\nopt1 = torch.optim.Adam(model1.parameters(), lr=config.lr, weight_decay=1e-5)\n\nXtr_t, ytr_t = torch.tensor(Xtr, dtype=torch.float32), torch.tensor(ytr, dtype=torch.long)\nXval_t = torch.tensor(Xval, dtype=torch.float32)\n\nbest_map3_m1 = 0\nfor epoch in range(config.epochs):\n    model1.train()\n    perm = torch.randperm(len(Xtr_t))\n    total_loss = 0\n    for i in range(0, len(perm), config.batch_size):\n        idx = perm[i:i + config.batch_size]\n        xb, yb = Xtr_t[idx].to(DEVICE), ytr_t[idx].to(DEVICE)\n        logits = model1(xb)\n        loss = F.cross_entropy(logits, yb)\n        opt1.zero_grad(); loss.backward(); opt1.step()\n        total_loss += loss.item() * len(idx)\n\n    model1.eval()\n    with torch.no_grad():\n        val_scores = model1(Xval_t.to(DEVICE)).cpu().numpy()\n    m3 = map_at_3(val_scores, yval)\n    val_acc = (val_scores.argmax(1) == yval).mean()\n    best_map3_m1 = max(best_map3_m1, m3)\n    wandb.log({\"epoch\": epoch, \"train_loss\": total_loss / len(Xtr_t),\n               \"val_map3\": m3, \"val_acc\": val_acc})\n\nprint(\"Model 1 best val MAP@3:\", best_map3_m1)\nrun1.summary[\"best_val_map3\"] = best_map3_m1\nrun1.finish()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:34.335516Z","iopub.execute_input":"2026-07-04T04:48:34.335746Z","iopub.status.idle":"2026-07-04T04:48:38.271378Z","shell.execute_reply.started":"2026-07-04T04:48:34.335726Z","shell.execute_reply":"2026-07-04T04:48:38.270557Z"}},"outputs":[{"name":"stdout","text":"Model 1 best val MAP@3: 0.8661111111111113\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":""},"metadata":{}},{"output_type":"display_data",