    "class ScratchScorer(nn.Module):\n",
    "    def __init__(self, in_dim, hidden=128):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(in_dim, hidden),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "\n",
    "            nn.Linear(hidden, hidden),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "\n",
    "            nn.Linear(hidden, hidden // 2),\n",
    "            nn.ReLU(),\n",
    "\n",
    "            nn.Linear(hidden // 2, 1),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        B, K, Fd = x.shape\n",
    "        return self.net(x.reshape(B * K, Fd)).reshape(B, K)\n",
    "\n",
    "\n",
    "model1 = ScratchScorer(Xtr.shape[-1], config.hidden).to(DEVICE)\n",
    "\n",
    "opt1 = torch.optim.Adam(\n",
    "    model1.parameters(),\n",
    "    lr=config.lr,\n",
    "    weight_decay=1e-5\n",
    ")\n",
    "\n",
    "Xtr_t = torch.tensor(Xtr, dtype=torch.float32)\n",
    "ytr_t = torch.tensor(ytr, dtype=torch.long)\n",
    "Xval_t = torch.tensor(Xval, dtype=torch.float32)\n",
    "\n",
    "best_map3_m1 = -1\n",
    "best_state = None\n",
    "best_epoch = -1\n",
    "\n",
    "for epoch in range(config.epochs):\n",
    "\n",
    "    model1.train()\n",
    "    perm = torch.randperm(len(Xtr_t))\n",
    "    total_loss = 0\n",
    "\n",
    "    for i in range(0, len(perm), config.batch_size):\n",
    "\n",
    "        idx = perm[i:i + config.batch_size]\n",
    "\n",
    "        xb = Xtr_t[idx].to(DEVICE)\n",
    "        yb = ytr_t[idx].to(DEVICE)\n",
    "\n",
    "        logits = model1(xb)\n",
    "        loss = F.cross_entropy(logits, yb)\n",
    "\n",
    "        opt1.zero_grad()\n",
    "        loss.backward()\n",
    "        opt1.step()\n",
    "\n",
    "        total_loss += loss.item() * len(idx)\n",
    "\n",
    "    model1.eval()\n",
    "\n",
    "    with torch.no_grad():\n",
    "        val_scores = model1(\n",
    "            Xval_t.to(DEVICE)\n",
    "        ).cpu().numpy()\n",
    "\n",
    "    m3 = map_at_3(val_scores, yval)\n",
    "    val_acc = (val_scores.argmax(1) == yval).mean()\n",
    "\n",
    "    if m3 > best_map3_m1:\n",
    "        best_map3_m1 = m3\n",
    "        best_epoch = epoch\n",
    "        best_state = {\n",
    "            k: v.detach().cpu().clone()\n",
    "            for k, v in model1.state_dict().items()\n",
    "        }\n",
    "\n",
    "    wandb.log({\n",
    "        \"epoch\": epoch,\n",
    "        \"train_loss\": total_loss / len(Xtr_t),\n",
    "        \"val_map3\": m3,\n",
    "        \"val_acc\": val_acc,\n",
    "        \"best_val_map3\": best_map3_m1\n",
    "    })\n",
    "\n",
    "model1.load_state_dict(best_state)\n",
    "\n",
    "print(\"Best epoch:\", best_epoch)\n",
    "print(\"Best Model 1 MAP@3:\", best_map3_m1)\n",
    "\n",
    "run1.summary[\"best_val_map3\"] = best_map3_m1\n",
    "run1.summary[\"best_epoch\"] = best_epoch\n",
    "run1.finish()\n"
   ]
