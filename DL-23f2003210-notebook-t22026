    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "train_groups = train.groupby('opt_key').first().reset_index()\n",
    "train_group_vecs = embed([' '.join([r[o] for o in opt_cols]) for _, r in train_groups.iterrows()])\n",
    "\n",
    "unmatched_idx = [i for i, key in enumerate(test['opt_key']) if key not in lookup]\n",
    "if unmatched_idx:\n",
    "    test_sig = [' '.join([test.iloc[i][o] for o in opt_cols]) for i in unmatched_idx]\n",
    "    test_vecs = embed(test_sig)\n",
    "    sims = cosine_similarity(test_vecs, train_group_vecs)\n",
    "    best_match = sims.argmax(axis=1)\n",
    "    best_sim = sims.max(axis=1)\n",
    "\n",
    "    THRESH = 0.97\n",
    "    fuzzy_hits = 0\n",
    "    for k, i in enumerate(unmatched_idx):\n",
    "        if best_sim[k] >= THRESH:\n",
    "            fuzzy_hits += 1\n",
    "            ans = train_groups.iloc[best_match[k]]['answer']\n",
    "            boost = np.zeros(5); boost[OPT2IDX[ans]] = 1.0\n",
    "            test_probs_final[i] = boost\n",
    "    print(f\"Fuzzy near-duplicate matches: {fuzzy_hits} additional rows\")"
   ]
