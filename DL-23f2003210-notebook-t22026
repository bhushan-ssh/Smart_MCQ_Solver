24Z","shell.execute_reply.started":"2026-07-05T12:03:34.156706Z","shell.execute_reply":"2026-07-05T12:04:13.75659Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nimport os, re, json, math\nimport numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.model_selection import train_test_split\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nSEED = 42\nnp.random.seed(SEED); torch.manual_seed(SEED)\nDEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\nprint('Device:', DEVICE)\n\nOPTS = ['A', 'B', 'C', 'D', 'E']\nOPT2IDX = {o: i for i, o in enumerate(OPTS)}\n\nTRAIN_PATH = '/kaggle/input/competitions/smart-mcq-solver-challenge/train.csv'   # <-- update path\nTEST_PATH  = '/kaggle/input/competitions/smart-mcq-solver-challenge/test.csv'    # <-- update path\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:13.759172Z","iopub.execute_input":"2026-07-05T12:04:13.759526Z","iopub.status.idle":"2026-07-05T12:04:20.099435Z","shell.execute_reply.started":"2026-07-05T12:04:13.759498Z","shell.execute_reply":"2026-07-05T12:04:20.098313Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import wandb\nfrom kaggle_secrets import UserSecretsClient\n\nWANDB_PROJECT = \"23f2003210-t22026\"\nWANDB_ENTITY  = None\n\nuser_secrets = UserSecretsClient()\nwandb_key = user_secrets.get_secret(\"WANDB_API_KEY\")\nwandb.login(key=wandb_key)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:20.100536Z","iopub.execute_input":"2026-07-05T12:04:20.101244Z","iopub.status.idle":"2026-07-05T12:04:29.405536Z","shell.execute_reply.started":"2026-07-05T12:04:20.101216Z","shell.execute_reply":"2026-07-05T12:04:29.404814Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 1. Load & Clean Data","metadata":{}},{"cell_type":"code","source":"\ntrain = pd.read_csv(TRAIN_PATH)\ntest  = pd.read_csv(TEST_PATH)\n\ndef clean(t):\n    t = re.sub(r'\\s+', ' ', str(t)).strip()\n    return t\n\nfor c in ['prompt'] + OPTS:\n    train[c] = train[c].astype(str).map(clean)\n    test[c]  = test[c].astype(str).map(clean)\n\nprint(train.shape, test.shape)\ntrain.head(2)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:29.406389Z","iopub.execute_input":"2026-07-05T12:04:29.406682Z","iopub.status.idle":"2026-07-05T12:04:29.640447Z","shell.execute_reply.started":"2026-07-05T12:04:29.406657Z","shell.execute_reply":"2026-07-05T12:04:29.639523Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.model_selection import GroupShuffleSplit\n\nopt_cols = ['A', 'B', 'C', 'D', 'E']\ntrain['opt_key'] = train[opt_cols].astype(str).agg('|'.join, axis=1)\n\ngss = GroupShuffleSplit(n_splits=1, test_size=0.15, random_state=SEED)\ntr_idx, val_idx = next(gss.split(train, groups=train['opt_key']))\ntr_df, val_df = train.iloc[tr_idx], train.iloc[val_idx]\n\nytr  = tr_df['answer'].map(OPT2IDX).values\nyval = val_df['answer'].map(OPT2IDX).values\nprint(len(tr_df), len(val_df))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:29.642438Z","iopub.execute_input":"2026-07-05T12:04:29.643084Z","iopub.status.idle":"2026-07-05T12:04:29.675198Z","shell.execute_reply.started":"2026-07-05T12:04:29.64305Z","shell.execute_reply":"2026-07-05T12:04:29.674345Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. MAP@3 Metric","metadata":{}},{"cell_type":"code","source":"\ndef map_at_3(scores, y_true):\n   \n    order = np.argsort(-scores, axis=1)[:, :3]\n    ap = 0.0\n    for i in range(len(y_true)):\n        preds = order[i]\n        hits = np.where(preds == y_true[i])[0]\n        if len(hits):\n            ap += 1.0 / (hits[0] + 1)\n    return ap / len(y_true)\n\ndef top3_labels(scores):\n    order = np.argsort(-scores, axis=1)[:, :3]\n    return [' '.join(OPTS[j] for j in row) for row in order]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:29.676525Z","iopub.execute_input":"2026-07-05T12:04:29.676881Z","iopub.status.idle":"2026-07-05T12:04:29.688618Z","shell.execute_reply.started":"2026-07-05T12:04:29.67683Z","shell.execute_reply":"2026-07-05T12:04:29.687633Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"\n## 3. MODEL 1 — From Scratch: TF-IDF/SVD Embeddings + MLP Scorer\n\nNo pretrained weights anywhere. TF-IDF + SVD gives classical \"embeddings\" (matches Milestone 1),\nand a small MLP (randomly initialised, trained only on this data) scores each option.\n","metadata":{}},{"cell_type":"code","source":"\nrun1 = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model1_scratch_tfidf_mlp\",\n                   job_type=\"train\", config={\"model\": \"tfidf_svd_mlp\", \"svd_dim\": 128,\n                                              \"hidden\": 128, \"epochs\": 30, \"lr\": 1e-3, \"batch_size\": 64})\nconfig = run1.config\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:29.689646Z","iopub.execute_input":"2026-07-05T12:04:29.68991Z","iopub.status.idle":"2026-07-05T12:04:36.389205Z","shell.execute_reply.started":"2026-07-05T12:04:29.689888Z","shell.execute_reply":"2026-07-05T12:04:36.388621Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nall_texts = list(tr_df['prompt']) + [t for c in OPTS for t in tr_df[c]]\ntfidf = TfidfVectorizer(max_features=20000, ngram_range=(1, 2), sublinear_tf=True)\ntfidf.fit(all_texts)\n\nsvd = TruncatedSVD(n_components=config.svd_dim, random_state=SEED)\nsvd.fit(tfidf.transform(all_texts))\n\ndef embed(texts):\n    return svd.transform(tfidf.transform(texts))\n\ndef build_features(df):\n    p_emb = embed(df['prompt'].tolist())\n    feats = []\n    for opt in OPTS:\n        o_emb = embed(df[opt].tolist())\n        prod = p_emb * o_emb\n        diff = np.abs(p_emb - o_emb)\n        cos = (p_emb * o_emb).sum(1) / (np.linalg.norm(p_emb, axis=1) * np.linalg.norm(o_emb, axis=1) + 1e-8)\n        feats.append(np.concatenate([p_emb, o_emb, prod, diff, cos[:, None]], axis=1))\n    return np.stack(feats, axis=1)  # (N, 5, F)\n\nXtr  = build_features(tr_df)\nXval = build_features(val_df)\nprint(\"feature shape:\", Xtr.shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:36.39002Z","iopub.execute_input":"2026-07-05T12:04:36.390746Z","iopub.status.idle":"2026-07-05T12:04:39.169984Z","shell.execute_reply.started":"2026-07-05T12:04:36.390717Z","shell.execute_reply":"2026-07-05T12:04:39.169083Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nclass ScratchScorer(nn.Module):\n    def __init__(self, in_dim, hidden=128):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(in_dim, hidden), nn.ReLU(), nn.Dropout(0.3),\n            nn.Linear(hidden, hidden // 2), nn.ReLU(),\n            nn.Linear(hidden // 2, 1),\n        )\n    def forward(self, x):  # (B,5,F)\n        B, K, Fd = x.shape\n        return self.net(x.reshape(B * K, Fd)).reshape(B, K)\n\nmodel1 = ScratchScorer(Xtr.shape[-1], config.hidden).to(DEVICE)\nopt1 = torch.optim.Adam(model1.parameters(), lr=config.lr, weight_decay=1e-5)\n\nXtr_t, ytr_t = torch.tensor(Xtr, dtype=torch.float32), torch.tensor(ytr, dtype=torch.long)\nXval_t = torch.tensor(Xval, dtype=torch.float32)\n\nbest_map3_m1 = 0\nfor epoch in range(config.epochs):\n    model1.train()\n    perm = torch.randperm(len(Xtr_t))\n    total_loss = 0\n    for i in range(0, len(perm), config.batch_size):\n        idx = perm[i:i + config.batch_size]\n        xb, yb = Xtr_t[idx].to(DEVICE), ytr_t[idx].to(DEVICE)\n        logits = model1(xb)\n        loss = F.cross_entropy(logits, yb)\n        opt1.zero_grad(); loss.backward(); opt1.step()\n        total_loss += loss.item() * len(idx)\n\n    model1.eval()\n    with torch.no_grad():\n        val_scores = model1(Xval_t.to(DEVICE)).cpu().numpy()\n    m3 = map_at_3(val_scores, yval)\n    val_acc = (val_scores.argmax(1) == yval).mean()\n    best_map3_m1 = max(best_map3_m1, m3)\n    wandb.log({\"epoch\": epoch, \"train_loss\": total_loss / len(Xtr_t),\n               \"val_map3\": m3, \"val_acc\": val_acc})\n\nprint(\"Model 1 best val MAP@3:\", best_map3_m1)\nrun1.summary[\"best_val_map3\"] = best_map3_m1\nrun1.finish()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:39.171404Z","iopub.execute_input":"2026-07-05T12:04:39.171825Z","iopub.status.idle":"2026-07-05T12:04:46.203002Z","shell.execute_reply.started":"2026-07-05T12:04:39.171785Z","shell.execute_reply":"2026-07-05T12:04:46.202009Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"Xtest_m1 = build_features(test)\nmodel1.eval()\nwith torch.no_grad():\n    test_scores_m1 = model1(torch.tensor(Xtest_m1, dtype=torch.float32).to(DEVICE)).cpu().numpy()\ntest_probs_m1 = F.softmax(torch.tensor(test_scores_m1), dim=1).numpy()\nval_probs_m1  = F.softmax(torch.tensor(val_scores), dim=1).numpy()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:46.204085Z","iopub.execute_input":"2026-07-05T12:04:46.205202Z","iopub.status.idle":"2026-07-05T12:04:46.358213Z","shell.execute_reply.started":"2026-07-05T12:04:46.20513Z","shell.execute_reply":"2026-07-05T12:04:46.357536Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"\n## 4. MODEL 2 — Pretrained (Zero-shot): Sentence-Transformer Embeddings\n\nUses `sentence-transformers/all-MiniLM-L6-v2` (pretrained, frozen — no fine-tuning) to embed the\nprompt and each option, then ranks options by cosine similarity. This satisfies the **pretrained\nmodel** requirement with no training loop.\n","metadata":{}},{"cell_type":"code","source":"\nrun2 = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model2_pretrained_minilm\",\n                   job_type=\"eval\", config={\"model\": \"sentence-transformers/all-MiniLM-L6-v2\"})\n\nfrom sentence_transformers import SentenceTransformer\nst_model = SentenceTransformer(run2.config.model, device=DEVICE)\n\ndef st_scores(df):\n    prompts = df['prompt'].tolist()\n    p_emb = st_model.encode(prompts, batch_size=64, show_progress_bar=True, normalize_embeddings=True)\n    scores = np.zeros((len(df), 5))\n    for j, opt in enumerate(OPTS):\n        o_emb = st_model.encode(df[opt].tolist(), batch_size=64, show_progress_bar=True,\n                                 normalize_embeddings=True)\n        scores[:, j] = (p_emb * o_emb).sum(1)  # cosine sim (already normalized)\n    return scores\n\nval_scores_m2 = st_scores(val_df)\nm3_m2 = map_at_3(val_scores_m2, yval)\nprint(\"Model 2 (zero-shot) val MAP@3:\", m3_m2)\nrun2.summary[\"val_map3\"] = m3_m2\nwandb.log({\"val_map3\": m3_m2})\nrun2.finish()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:04:46.35925Z","iopub.execute_input":"2026-07-05T12:04:46.359515Z","iopub.status.idle":"2026-07-05T12:05:07.535142Z","shell.execute_reply.started":"2026-07-05T12:04:46.35949Z","shell.execute_reply":"2026-07-05T12:05:07.534209Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\ntest_scores_m2 = st_scores(test)\nval_probs_m2  = F.softmax(torch.tensor(val_scores_m2) * 10, dim=1).numpy()   # temperature-scaled\ntest_probs_m2 = F.softmax(torch.tensor(test_scores_m2) * 10, dim=1).numpy()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:05:07.536428Z","iopub.execute_input":"2026-07-05T12:05:07.537497Z","iopub.status.idle":"2026-07-05T12:05:08.960355Z","shell.execute_reply.started":"2026-07-05T12:05:07.537466Z","shell.execute_reply":"2026-07-05T12:05:08.959425Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"\n## 5. MODEL 3 — Additional Model: LoRA Fine-tuned Transformer (DeBERTa-v3-small)\n\nA pretrained encoder is adapted with **LoRA** (Milestone 4) for the multiple-choice task itself —\nthis is the \"third model of your choice\" and doubles as your fine-tuning milestone deliverable.\n","metadata":{}},{"cell_type":"code","source":"\nrun3 = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model3_lora_deberta\",\n                   job_type=\"train\", config={\n                       \"base_model\": \"microsoft/deberta-v3-small\",\n                       \"lora_r\": 8, \"lora_alpha\": 16, \"lora_dropout\": 0.05,\n                       \"epochs\": 3, \"lr\": 2e-4, \"batch_size\": 8, \"max_len\": 256,\n                   })\ncfg3 = run3.config\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-05T12:05:08.961417Z","iopub.execute_input":"2026-07-05T12:05:08.961982Z","iopub.status.idle":"2026-07-05T12:05:15.472104Z","shell.execute_reply.started":"2026-07-05T12:05:08.961952Z","shell.execute_reply":"2026-07-05T12:05:15.471047Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nfrom transformers import AutoTokenizer, AutoModelForMultipleChoice, TrainingArguments, Trainer\nfrom peft import LoraConfig, get_peft_model, TaskType\n\ntok = AutoTokenizer.from_pretrained(cfg3.base_model)\n\ndef to_mc_features(df, has_label=True):\n    first_sentences = [[p] * 5 for p in df['prompt']]\n    second_sentences = [[df.iloc[i][opt] for opt in OPTS] for i in range(len(df))]\n    first_sentences = sum(first_sentences, [])\n    second_sentences = sum(second_sentences, [])\n    tokenized = tok(first_sentences, second_sentences, truncation=True,\n                    max_length=cfg3.max_len, padding='max_length')\n    features = {k: [v[i:i + 5] for i in range(0, len(v), 5)] for k, v in tokenized.items()}\n    if has_label:\n        features['labels'] = df['answer'].map(OPT2IDX).tolist()\n    return features\n\nfrom datasets import Dataset\ntrain_ds = Dataset.from_dict(to_mc_features(tr_df))\nval_ds   = Dataset.from_dict(to_mc_features(val_df))\ntest_ds  = Dataset.from_dict(to_mc_features(test, has_la