splay.HTML object>","text/html":"Find logs at: <code>./wandb/run-20260704_044825-ipugz7ux/logs</code>"},"metadata":{}}],"execution_count":9},{"id":"6ab18c25","cell_type":"code","source":"\n# Test-set inference for Model 1 (used later for ensembling)\nXtest_m1 = build_features(test)\nmodel1.eval()\nwith torch.no_grad():\n    test_scores_m1 = model1(torch.tensor(Xtest_m1, dtype=torch.float32).to(DEVICE)).cpu().numpy()\n# convert to a probability-like scale for ensembling\ntest_probs_m1 = F.softmax(torch.tensor(test_scores_m1), dim=1).numpy()\nval_probs_m1  = F.softmax(torch.tensor(val_scores), dim=1).numpy()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:38.273965Z","iopub.execute_input":"2026-07-04T04:48:38.274666Z","iopub.status.idle":"2026-07-04T04:48:38.424477Z","shell.execute_reply.started":"2026-07-04T04:48:38.274640Z","shell.execute_reply":"2026-07-04T04:48:38.423286Z"}},"outputs":[],"execution_count":10},{"id":"56867747","cell_type":"markdown","source":"\n## 4. MODEL 2 — Pretrained (Zero-shot): Sentence-Transformer Embeddings\n\nUses `sentence-transformers/all-MiniLM-L6-v2` (pretrained, frozen — no fine-tuning) to embed the\nprompt and each option, then ranks options by cosine similarity. This satisfies the **pretrained\nmodel** requirement with no training loop.\n","metadata":{}},{"id":"0dcc4765","cell_type":"code","source":"\nrun2 = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model2_pretrained_minilm\",\n                   job_type=\"eval\", config={\"model\": \"sentence-transformers/all-MiniLM-L6-v2\"})\n\nfrom sentence_transformers import SentenceTransformer\nst_model = SentenceTransformer(run2.config.model, device=DEVICE)\n\ndef st_scores(df):\n    prompts = df['prompt'].tolist()\n    p_emb = st_model.encode(prompts, batch_size=64, show_progress_bar=True, normalize_embeddings=True)\n    scores = np.zeros((len(df), 5))\n    for j, opt in enumerate(OPTS):\n        o_emb = st_model.encode(df[opt].tolist(), batch_size=64, show_progress_bar=True,\n                                 normalize_embeddings=True)\n        scores[:, j] = (p_emb * o_emb).sum(1)  # cosine sim (already normalized)\n    return scores\n\nval_scores_m2 = st_scores(val_df)\nm3_m2 = map_at_3(val_scores_m2, yval)\nprint(\"Model 2 (zero-shot) val MAP@3:\", m3_m2)\nrun2.summary[\"val_map3\"] = m3_m2\nwandb.log({\"val_map3\": m3_m2})\nrun2.finish()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-04T04:48:38.425666Z","iopub.execute_input":"2026-07-04T04:48:38.425954Z"}},"outputs":[],"execution_count":null},{"id":"ec8b4e68","cell_type":"code","source":"\ntest_scores_m2 = st_scores(test)\nval_probs_m2  = F.softmax(torch.tensor(val_scores_m2) * 10, dim=1).numpy()   # temperature-scaled\ntest_probs_m2 = F.softmax(torch.tensor(test_scores_m2) * 10, dim=1).numpy()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"e59bf8de","cell_type":"markdown","source":"\n## 5. MODEL 3 — Additional Model: LoRA Fine-tuned Transformer (DeBERTa-v3-small)\n\nA pretrained encoder is adapted with **LoRA** (Milestone 4) for the multiple-choice task itself —\nthis is the \"third model of your choice\" and doubles as your fine-tuning milestone deliverable.\n","metadata":{}},{"id":"2e21b57f","cell_type":"code","source":"\nrun3 = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model3_lora_deberta\",\n                   job_type=\"train\", config={\n                       \"base_model\": \"microsoft/deberta-v3-small\",\n                       \"lora_r\": 8, \"lora_alpha\": 16, \"lora_dropout\": 0.05,\n                       \"epochs\": 3, \"lr\": 2e-4, \"batch_size\": 8, \"max_len\": 256,\n                   })\ncfg3 = run3.config\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"f7c8bc1f","cell_type":"code","source":"\nfrom transformers import AutoTokenizer, AutoModelForMultipleChoice, TrainingArguments, Trainer\nfrom peft import LoraConfig, get_peft_model, TaskType\n\ntok = AutoTokenizer.from_pretrained(cfg3.base_model)\n\ndef to_mc_features(df, has_label=True):\n    first_sentences = [[p] * 5 for p in df['prompt']]\n    second_sentences = [[df.iloc[i][opt] for opt in OPTS] for i in range(len(df))]\n    first_sentences = sum(first_sentences, [])\n    second_sentences = sum(second_sentences, [])\n    tokenized = tok(first_sentences, second_sentences, truncation=True,\n                    max_length=cfg3.max_len, padding='max_length')\n    features = {k: [v[i:i + 5] for i in range(0, len(v), 5)] for k, v in tokenized.items()}\n    if has_label:\n        features['labels'] = df['answer'].map(OPT2IDX).tolist()\n    return features\n\nfrom datasets import Dataset\ntrain_ds = Dataset.from_dict(to_mc_features(tr_df))\nval_ds   = Dataset.from_dict(to_mc_features(val_df))\ntest_ds  = Dataset.from_dict(to_mc_features(test, has_label=False))\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"fef7b790","cell_type":"code","source":"\nfrom dataclasses import dataclass\nfrom transformers.tokenization_utils_base import PreTrainedTokenizerBase\nfrom typing import Optional, Union\nimport torch as _torch\n\n@dataclass\nclass DataCollatorForMultipleChoice:\n    tokenizer: PreTrainedTokenizerBase\n    padding: Union[bool, str] = True\n\n    def __call__(self, features):\n        label_name = \"labels\" if \"labels\" in features[0] else None\n        labels = [f.pop(label_name) for f in features] if label_name else None\n        batch_size = len(features)\n        num_choices = len(features[0][\"input_ids\"])\n        flattened = [\n            {k: v[i] for k, v in f.items()} for f in features for i in range(num_choices)\n        ]\n        batch = self.tokenizer.pad(flattened, padding=self.padding, return_tensors=\"pt\")\n        batch = {k: v.view(batch_size, num_choices, -1) for k, v in batch.items()}\n        if labels is not None:\n            batch[\"labels\"] = _torch.tensor(labels, dtype=_torch.int64)\n        return batch\n\ncollator = DataCollatorForMultipleChoice(tokenizer=tok)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"ddfa40da","cell_type":"code","source":"\nbase_model = AutoModelForMultipleChoice.from_pretrained(cfg3.base_model)\n\nlora_config = LoraConfig(\n    task_type=TaskType.SEQ_CLS,   # multiple-choice head is treated as a classification head for LoRA targeting\n    r=cfg3.lora_r, lora_alpha=cfg3.lora_alpha, lora_dropout=cfg3.lora_dropout,\n    target_modules=[\"query_proj\", \"key_proj\", \"value_proj\"],  # DeBERTa-v3 attention proj names\n)\nmodel3 = get_peft_model(base_model, lora_config)\nmodel3.print_trainable_parameters()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"247f3830-bf5e-486e-9d9a-22056145c37c","cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"5a1e0492","cell_type":"code","source":"\ndef compute_metrics(eval_pred):\n    logits, labels = eval_pred\n    scores = torch.softmax(torch.tensor(logits), dim=1).numpy()\n    m3 = map_at_3(scores, labels)\n    acc = (scores.argmax(1) == labels).mean()\n    return {\"map3\": m3, \"accuracy\": acc}\n\ntraining_args = TrainingArguments(\n    output_dir=\"./model3_ckpt\",\n    per_device_train_batch_size=cfg3.batch_size,\n    per_device_eval_batch_size=cfg3.batch_size * 2,\n    learning_rate=cfg3.lr,\n    num_train_epochs=cfg3.epochs,\n    eval_strategy=\"epoch\",\n    save_strategy=\"epoch\",\n    load_best_model_at_end=True,\n    metric_for_best_model=\"map3\",\n    report_to=\"wandb\",\n    run_name=\"model3_lora_deberta\",\n    fp16=torch.cuda.is_available(),\n)\n\ntrainer = Trainer(\n    model=model3,\n    args=training_args,\n    train_dataset=train_ds,\n    eval_dataset=val_ds,\n    data_collator=collator,\n    processing_class=tok,   # was: tokenizer=tok\n    compute_metrics=compute_metrics,\n)\ntrainer.train()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"a00ffe4b","cell_type":"code","source":"\nval_pred = trainer.predict(val_ds)\nval_logits_m3 = val_pred.predictions\nval_probs_m3 = torch.softmax(torch.tensor(val_logits_m3), dim=1).numpy()\nm3_m3 = map_at_3(val_probs_m3, yval)\nprint(\"Model 3 (LoRA fine-tuned) val MAP@3:\", m3_m3)\nrun3.summary[\"val_map3\"] = m3_m3\nrun3.finish()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"e6e15b69","cell_type":"code","source":"\ntest_pred = trainer.predict(test_ds)\ntest_probs_m3 = torch.softmax(torch.tensor(test_pred.predictions), dim=1).numpy()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"0fd27268","cell_type":"markdown","source":"\n## 6. Compare All 3 Models in W&B\n","metadata":{}},{"id":"7c5e3b53","cell_type":"code","source":"\ncompare_run = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model_comparison\", job_type=\"eval\")\ntable = wandb.Table(columns=[\"model\", \"type\", \"val_map3\"], data=[\n    [\"Model 1 - TF-IDF/SVD + MLP\", \"From scratch\", best_map3_m1],\n    [\"Model 2 - MiniLM (SentenceTransformers)\", \"Pretrained (zero-shot)\", m3_m2],\n    [\"Model 3 - DeBERTa-v3 + LoRA\", \"Additional (fine-tuned)\", m3_m3],\n])\ncompare_run.log({\"model_comparison\": table})\ncompare_run.finish()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"e0cd7e8b","cell_type":"markdown","source":"\n## 7. Ensemble & Final Submission\n\nSimple weighted average of the three models' probability distributions over A–E. Tune the\nweights using validation MAP@3 (a quick grid search is included) before scoring the test set.\n","metadata":{}},{"id":"0c92b4a6","cell_type":"code","source":"\ndef ensemble_map3(w1, w2, w3):\n    probs = w1 * val_probs_m1 + w2 * val_probs_m2 + w3 * val_probs_m3\n    return map_at_3(probs, yval)\n\nbest = (0, None)\nfor w1 in np.arange(0, 1.01, 0.1):\n    for w2 in np.arange(0, 1.01 - w1, 0.1):\n        w3 = 1 - w1 - w2\n        m = ensemble_map3(w1, w2, w3)\n        if m > best[0]:\n            best = (m, (round(w1,2), round(w2,2), round(w3,2)))\n\nprint(\"Best ensemble val MAP@3:\", best[0], \"weights (m1,m2,m3):\", best[1])\nw1, w2, w3 = best[1]\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"06cd37c5","cell_type":"code","source":"\nens_run = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"ensemble_final\", job_type=\"eval\",\n                      config={\"w1\": w1, \"w2\": w2, \"w3\": w3})\nens_run.summary[\"val_map3\"] = best[0]\nens_run.finish()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"746cd6d0","cell_type":"code","source":"\ntest_probs_ens = w1 * test_probs_m1 + w2 * test_probs_m2 + w3 * test_probs_m3\npreds = top3_labels(test_probs_ens)\n\nsubmission = pd.DataFrame({\"ID\": test['id'], \"Prediction\": preds})\nsubmission.to_csv(\"submission.csv\", index=False)\nsubmission.head()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"e575b4a4","cell_type":"markdown","source":"\n## 8. Next Steps\n- Upload `model1` (state_dict), `tfidf`/`svd` objects, and the LoRA adapter from `model3` to\n  **Kaggle Hub** so your inference notebook can load them without retraining.\n- Push this notebook + a clean `train.py` per model into your GitHub repo (`/scripts`, `/notebooks`)\n  with a proper commit history spread across the weeks — not a single last-minute commit.\n- Write your report using the val MAP@3 table above (Section 6) as your model-comparison table,\n  plus error analysis on validation rows the ensemble still gets wrong.\n","metadata":{}}]}