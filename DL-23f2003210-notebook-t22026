    "\n",
    "class ScratchScorer(nn.Module):\n",
    "    def __init__(self, in_dim, hidden=128):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(in_dim, hidden), nn.ReLU(), nn.Dropout(0.3),\n",
    "            nn.Linear(hidden, hidden // 2), nn.ReLU(),\n",
    "            nn.Linear(hidden // 2, 1),\n",
    "        )\n",
    "    def forward(self, x):  # (B,5,F)\n",
    "        B, K, Fd = x.shape\n",
    "        return self.net(x.reshape(B * K, Fd)).reshape(B, K)\n",
    "\n",
    "model1 = ScratchScorer(Xtr.shape[-1], config.hidden).to(DEVICE)\n",
    "opt1 = torch.optim.Adam(model1.parameters(), lr=config.lr, weight_decay=1e-5)\n",
    "\n",
    "Xtr_t, ytr_t = torch.tensor(Xtr, dtype=torch.float32), torch.tensor(ytr, dtype=torch.long)\n",
    "Xval_t = torch.tensor(Xval, dtype=torch.float32)\n",
    "\n",
    "best_map3_m1 = 0\n",
    "for epoch in range(config.epochs):\n",
    "    model1.train()\n",
    "    perm = torch.randperm(len(Xtr_t))\n",
    "    total_loss = 0\n",
    "    for i in range(0, len(perm), config.batch_size):\n",
    "        idx = perm[i:i + config.batch_size]\n",
    "        xb, yb = Xtr_t[idx].to(DEVICE), ytr_t[idx].to(DEVICE)\n",
    "        logits = model1(xb)\n",
    "        loss = F.cross_entropy(logits, yb)\n",
    "        opt1.zero_grad(); loss.backward(); opt1.step()\n",
    "        total_loss += loss.item() * len(idx)\n",
    "\n",
    "    model1.eval()\n",
    "    with torch.no_grad():\n",
    "        val_scores = model1(Xval_t.to(DEVICE)).cpu().numpy()\n",
    "    m3 = map_at_3(val_scores, yval)\n",
    "    val_acc = (val_scores.argmax(1) == yval).mean()\n",
    "    best_map3_m1 = max(best_map3_m1, m3)\n",
    "    wandb.log({\"epoch\": epoch, \"train_loss\": total_loss / len(Xtr_t),\n",
