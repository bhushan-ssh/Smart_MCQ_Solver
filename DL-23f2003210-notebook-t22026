    "\n",
    "all_texts = list(tr_df['prompt']) + [t for c in OPTS for t in tr_df[c]]\n",
    "tfidf = TfidfVectorizer(max_features=20000, ngram_range=(1, 2), sublinear_tf=True)\n",
    "tfidf.fit(all_texts)\n",
    "\n",
    "svd = TruncatedSVD(n_components=config.svd_dim, random_state=SEED)\n",
    "svd.fit(tfidf.transform(all_texts))\n",
    "\n",
    "def embed(texts):\n",
    "    return svd.transform(tfidf.transform(texts))\n",
    "\n",
    "def build_features(df):\n",
    "    p_emb = embed(df['prompt'].tolist())\n",
    "    feats = []\n",
    "    for opt in OPTS:\n",
    "        o_emb = embed(df[opt].tolist())\n",
    "        prod = p_emb * o_emb\n",
    "        diff = np.abs(p_emb - o_emb)\n",
    "        cos = (p_emb * o_emb).sum(1) / (np.linalg.norm(p_emb, axis=1) * np.linalg.norm(o_emb, axis=1) + 1e-8)\n",
    "        feats.append(np.concatenate([p_emb, o_emb, prod, diff, cos[:, None]], axis=1))\n",
    "    return np.stack(feats, axis=1)  # (N, 5, F)\n",
    "\n",
    "Xtr  = build_features(tr_df)\n",
    "Xval = build_features(val_df)\n",
    "print(\"feature shape:\", Xtr.shape)\n"
   ]
