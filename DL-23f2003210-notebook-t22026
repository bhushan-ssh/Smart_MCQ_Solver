.to(DEVICE)\n        logits = model1(xb)\n        loss = F.cross_entropy(logits, yb)\n        opt1.zero_grad(); loss.backward(); opt1.step()\n        total_loss += loss.item() * len(idx)\n\n    model1.eval()\n    with torch.no_grad():\n        val_scores = model1(Xval_t.to(DEVICE)).cpu().numpy()\n    m3 = map_at_3(val_scores, yval)\n    val_acc = (val_scores.argmax(1) == yval).mean()\n    best_map3_m1 = max(best_map3_m1, m3)\n    wandb.log({\"epoch\": epoch, \"train_loss\": total_loss / len(Xtr_t),\n               \"val_map3\": m3, \"val_acc\": val_acc})\n\nprint(\"Model 1 best val MAP@3:\", best_map3_m1)\nrun1.summary[\"best_val_map3\"] = best_map3_m1\nrun1.finish()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T15:45:00.477899Z","iopub.execute_input":"2026-07-30T15:45:00.478126Z","iopub.status.idle":"2026-07-30T15:45:07.35111Z","shell.execute_reply.started":"2026-07-30T15:45:00.478108Z","shell.execute_reply":"2026-07-30T15:45:07.35015Z"}},"outputs":[{"name":"stdout","text":"Model 1 best val MAP@3: 0.6063708759954496\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<br>    <style><br>        .wandb-row {<br>            display: flex;<br>            flex-direction: row;<br>            flex-wrap: wrap;<br>            justify-content: flex-start;<br>            width: 100%;<br>        }<br>        .wandb-col {<br>            display: flex;<br>            flex-direction: column;<br>            flex-basis: 100%;<br>            flex: 1;<br>            padding: 10px;<br>        }<br>    </style><br><div class=\"wandb-row\"><div class=\"wandb-col\"><h3>Run history:</h3><br/><table class=\"wandb\"><tr><td>epoch</td><td>▁▁▁▂▂▂▂▃▃▃▃▄▄▄▄▅▅▅▅▆▆▆▆▇▇▇▇███</td></tr><tr><td>train_loss</td><td>███▇▆▅▅▅▄▄▄▄▃▃▃▃▃▂▂▂▂▂▂▂▂▁▁▁▁▁</td></tr><tr><td>val_acc</td><td>▂▂▂▃