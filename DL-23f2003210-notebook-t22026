    "def train_rnn_model(model, run_name, train_loader, val_loader, epochs=12, lr=1e-3,\n",
    "                     weight_decay=1e-5, patience=3, grad_clip=1.0, config_extra=None):\n",
    "    config = {\n",
    "        \"epochs\": epochs, \"lr\": lr, \"weight_decay\": weight_decay,\n",
    "        \"batch_size\": train_loader.batch_size, \"patience\": patience,\n",
    "        \"grad_clip\": grad_clip, \"vocab_size\": VOCAB_SIZE, \"max_len\": MAX_LEN,\n",
    "    }\n",
    "    if config_extra:\n",
    "        config.update(config_extra)\n",
    "\n",
    "    run = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=run_name,\n",
    "                      job_type=\"train\", config=config, reinit=True)\n",
    "\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)\n",
    "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='max',\n",
    "                                                             factor=0.5, patience=1)\n",
    "\n",
    "    best_map3 = -1.0\n",
    "    best_state = None\n",
    "    epochs_without_improvement = 0\n",
    "\n",
    "    for epoch in range(epochs):\n",
    "        model.train()\n",
    "        total_loss, n = 0.0, 0\n",
    "        for ids, lengths, labels in train_loader:\n",
    "            ids, lengths, labels = ids.to(DEVICE), lengths.to(DEVICE), labels.to(DEVICE)\n",
    "            optimizer.zero_grad()\n",
    "            scores = model(ids, lengths)\n",
    "            loss = F.cross_entropy(scores, labels)\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model.parameters(), grad_clip)\n",
    "            optimizer.step()\n",
    "            total_loss += loss.item() * len(labels)\n",
    "            n += len(labels)\n",
    "\n",
    "        train_loss = total_loss / n\n",
