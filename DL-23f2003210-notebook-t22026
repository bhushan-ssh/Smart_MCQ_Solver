pby('opt_key')['answer'].first().to_dict()\n\ntest_probs_final = test_probs_ens.copy()\nmatched = 0\nfor i, key in enumerate(test['opt_key']):\n    if key in lookup:\n        matched += 1\n        boost = np.zeros(5)\n        boost[OPT2IDX[lookup[key]]] = 1.0\n        test_probs_final[i] = boost\nprint(f\"Exact-match lookup applied to {matched}/{len(test)} test rows\")\nprint(test.loc[test['opt_key'].isin(lookup), 'opt_key'].nunique(), \"unique matched groups\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-02T15:23:33.625739Z","iopub.execute_input":"2026-08-02T15:23:33.62621Z","iopub.status.idle":"2026-08-02T15:23:33.675888Z","shell.execute_reply.started":"2026-08-02T15:23:33.626153Z","shell.execute_reply":"2026-08-02T15:23:33.67503Z"}},"outputs":[{"name":"stdout","text":"Exact-match lookup applied to 458/500 test rows\n227 unique matched groups\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"from sklearn.metrics.pairwise import cosine_similarity\n\ntrain_groups = train.groupby('opt_key').first().reset_index()\ntrain_group_vecs = embed([' '.join([r[o] for o in opt_cols]) for _, r in train_groups.iterrows()])\n\nunmatched_idx = [i for i, key in enumerate(test['opt_key']) if key not in lookup]\nif unmatched_idx:\n    test_sig = [' '.join([test.iloc[i][o] for o in opt_cols]) for i in unmatched_idx]\n    test_vecs = embed(test_sig)\n    sims = cosine_similarity(test_vecs, train_group_vecs)\n    best_match = sims.argmax(axis=1)\n    best_sim = sims.max(axis=1)\n\n    THRESH = 0.97\n    fuzzy_hits = 0\n    for k, i in enumerate(unmatched_idx):\n        if best_sim[k] >= THRESH:\n            fuzzy_hits += 1\n            ans = train_groups.iloc[best_match[k]]['answer']\n            boost = np.zeros(5); boost[OPT2IDX[ans]] = 1.0\n            test_probs_final[i] = boost\n    print(f\"Fuzzy near-duplicate matches: {fuzzy_hits} additional rows\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-02T15:23:33.677003Z","iopub.execute_input":"2026-08-02T15:23:33.677523Z","iopub.status.idle":"2026-08-02T15:23:33.879566Z","shell.execute_reply.started":"2026-08-02T15:23:33.677472Z","shell.execute_reply":"2026-08-02T15:23:33.878338Z"}},"outputs":[{"name":"stdout","text":"Fuzzy near-duplicate matches: 42 additional rows\n","output_type":"stream"}],"execution_count":28},{"cell_type":"markdown","source":"### Write Final Submission\n\n**Problem:** The competition requires a submission file with the top-3 ranked options per test question, in the expected format.\n\n**Approach:** Take the top-3 ranked options per question from the duplicate-corrected ensemble probabilities and write them to `submission.csv`.","metadata":{}},{"cell_type":"code","source":"preds = top3_labels(test_probs_final)\nsubmission = pd.DataFrame({\"ID\": test['id'], \"Prediction\": preds})\nsubmission.to_csv(\"submission.csv\", index=False)\nsubmission.head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-02T15:23:33.880465Z","iopub.execute_input":"2026-08-02T15:23:33.882827Z","iopub.status.idle":"2026-08-02T15:23:33.90677Z","shell.execute_reply.started":"2026-08-02T15:23:33.882788Z","shell.execute_reply":"2026-08-02T15:23:33.903555Z"}},"outputs":[{"execution_count":29,"output_type":"execute_result","data":{"text/plain":"   ID Prediction\n0   1      A B C\n1   2      B A C\n2   3      B A C\n3   4      E A C\n4   5      C A B","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>ID</th>\n      <th>Prediction</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>1</td>\n      <td>A B C</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <t