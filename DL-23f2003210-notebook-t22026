    "from transformers import AutoTokenizer, AutoModelForMultipleChoice, TrainingArguments, Trainer\n",
    "from peft import LoraConfig, get_peft_model, TaskType\n",
    "\n",
    "tok = AutoTokenizer.from_pretrained(cfg3.base_model)\n",
    "\n",
    "def to_mc_features(df, has_label=True):\n",
    "    first_sentences = [[p] * 5 for p in df['prompt']]\n",
    "    second_sentences = [[df.iloc[i][opt] for opt in OPTS] for i in range(len(df))]\n",
    "    first_sentences = sum(first_sentences, [])\n",
    "    second_sentences = sum(second_sentences, [])\n",
    "    tokenized = tok(first_sentences, second_sentences, truncation=True,\n",
    "                    max_length=cfg3.max_len, padding='max_length')\n",
    "    features = {k: [v[i:i + 5] for i in range(0, len(v), 5)] for k, v in tokenized.items()}\n",
    "    if has_label:\n",
    "        features['labels'] = df['answer'].map(OPT2IDX).tolist()\n",
    "    return features\n",
    "\n",
    "from datasets import Dataset\n",
    "train_ds = Dataset.from_dict(to_mc_features(tr_df))\n",
    "val_ds   = Dataset.from_dict(to_mc_features(val_df))\n",
    "test_ds  = Dataset.from_dict(to_mc_features(test, has_label=False))\n"
