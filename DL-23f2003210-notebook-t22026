el.parameters(), lr=lr, weight_decay=weight_decay)\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='max',\n                                                             factor=0.5, patience=1)\n\n    best_map3 = -1.0\n    best_state = None\n    epochs_without_improvement = 0\n\n    for epoch in range(epochs):\n        model.train()\n        total_loss, n = 0.0, 0\n        for ids, lengths, labels in train_loader:\n            ids, lengths, labels = ids.to(DEVICE), lengths.to(DEVICE), labels.to(DEVICE)\n            optimizer.zero_grad()\n            scores = model(ids, lengths)\n            loss = F.cross_entropy(scores, labels)\n            loss.backward()\n            torch.nn.utils.clip_grad_norm_(model.parameters(), grad_clip)\n            optimizer.step()\n            total_loss += loss.item() * len(labels)\n            n += len(labels)\n\n        train_loss = total_loss / n\n        val_loss, val_map3, val_acc, val_f1, _ = evaluate_rnn(model, val_loader)\n        scheduler.step(val_map3)\n        current_lr = optimizer.param_groups[0]['lr']\n\n        wandb.log({\"epoch\": epoch, \"train_loss\": train_loss, \"val_loss\": val_loss,\n                   \"val_map3\": val_map3, \"val_acc\": val_acc, \"lr\": current_lr})\n        print(f\"[{run_name}] epoch {epoch:02d} | train_loss={train_loss:.4f} \"\n              f\"| val_loss={val_loss:.4f} | val_map3={val_map3:.4f} | val_acc={val_acc:.4f}\")\n\n        if val_map3 > best_map3:\n            best_map3 = val_map3\n            best_state = copy.deepcopy(model.state_dict())\n            epochs_without_improvement = 0\n        else:\n            epochs_without_improvement += 1\n            if epochs_without_improvement >= patience:\n                print(f\"[{run_name}] Early stopping at epoch {epoch} \"\n                      f\"(best val_map3={best_map3:.4f})\")\n                break\n\n    model.load_state_dict(best_state)\n    run.summary[\"best_val_map3\"] = best_map3\n    run.finish(