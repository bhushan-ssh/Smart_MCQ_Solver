    "def map_at_3(scores, y_true):\n",
    "    '''scores: (N,5) array of scores/probabilities per option, y_true: (N,) int labels 0-4.'''\n",
    "    order = np.argsort(-scores, axis=1)[:, :3]\n",
    "    ap = 0.0\n",
    "    for i in range(len(y_true)):\n",
    "        preds = order[i]\n",
    "        hits = np.where(preds == y_true[i])[0]\n",
    "        if len(hits):\n",
    "            ap += 1.0 / (hits[0] + 1)\n",
    "    return ap / len(y_true)\n",
    "\n",
    "def map3_accuracy(scores, y_true):\n",
    "    m3 = map_at_3(scores, y_true)\n",
    "    preds = scores.argmax(1)\n",
    "    acc = (preds == y_true).mean()\n",
    "    f1 = f1_score(y_true, preds, average='macro')\n",
    "    return m3, acc, f1\n",
    "\n",
    "def top3_labels(scores):\n",
    "    order = np.argsort(-scores, axis=1)[:, :3]\n",
    "    return [' '.join(OPTS[j] for j in row) for row in order]"
   ]
