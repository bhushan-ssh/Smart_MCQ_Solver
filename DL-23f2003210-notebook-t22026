eddings=True)\n        scores[:, j] = (p_emb * o_emb).sum(1)\n    return scores\n\nval_scores_m2 = st_scores(val_df)\nm3_m2 = map_at_3(val_scores_m2, yval)\nprint(\"Model 2 (zero-shot) val MAP@3:\", m3_m2)\nrun2.summary[\"val_map3\"] = m3_m2\nwandb.log({\"val_map3\": m3_m2})\nrun2.finish()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-02T15:19:33.797664Z","iopub.execute_input":"2026-08-02T15:19:33.798251Z","iopub.status.idle":"2026-08-02T15:20:04.564907Z","shell.execute_reply.started":"2026-08-02T15:19:33.798221Z","shell.execute_reply":"2026-08-02T15:20:04.563974Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Tracking run with wandb version 0.28.1"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Run data is saved locally in <code>/kaggle/working/wandb/run-20260802_151933-41xcmodf</code>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Syncing run <strong><a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026/runs/41xcmodf' target=\"_blank\">model2_pretrained_minilm</a></strong> to <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026' target=\"_blank\">Weights & Biases</a> (<a href='https://wandb.me/developer-guide' target=\"_blank\">docs</a>)<br>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":" View project at <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026' target=\"_blank\">https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026</a>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<