data":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-10T06:58:51.364507Z","iopub.execute_input":"2026-08-10T06:58:51.364919Z","iopub.status.idle":"2026-08-10T06:58:51.397846Z","shell.execute_reply.started":"2026-08-10T06:58:51.364894Z","shell.execute_reply":"2026-08-10T06:58:51.397168Z"}},"outputs":[{"name":"stdout","text":"Training rows  : 1707\nValidation rows: 293\n","output_type":"stream"}],"execution_count":23},{"id":"7029473c","cell_type":"markdown","source":"## 3. MAP@3 Metric","metadata":{}},{"id":"23eb94e5","cell_type":"code","source":"def map_at_3(scores, y_true):\n    \n    order = np.argsort(-scores, axis=1)[:, :3]\n    ap = 0.0\n    for i in range(len(y_true)):\n        preds = order[i]\n        hits = np.where(preds == y_true[i])[0]\n        if len(hits):\n            ap += 1.0 / (hits[0] + 1)\n    return ap / len(y_true)\n\ndef map3_accuracy(scores, y_true):\n    m3 = map_at_3(scores, y_true)\n    preds = scores.argmax(1)\n    acc = (preds == y_true).mean()\n    f1 = f1_score(y_true, preds, average='macro')\n    return m3, acc, f1\n\ndef top3_labels(scores):\n    order = np.argsort(-scores, axis=1)[:, :3]\n    return [' '.join(OPTS[j] for j in row) for row in order]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-10T06:58:51.398772Z","iopub.execute_input":"2026-08-10T06:58:51.399099Z","iopub.status.idle":"2026-08-10T06:58:51.406435Z","shell.execute_reply.started":"2026-08-10T06:58:51.399075Z","shell.execute_reply":"2026-08-10T06:58:51.405802Z"}},"outputs":[],"execution_count":24},{"id":"af6c7fef","cell_type":"markdown","source":"## 4. Model 1 — LSTM\n\n**Architecture.** A word-level vocabulary is built from the training prompts and options only.\nFor each of the 5 candidates we build a single sequence\n`question tokens + [SEP] + option tokens`, embed it with a trainable embedding layer, encode it\nwith a **bidirectional LSTM**, pool the encoder outputs (masked mean + max pooling concatenated\nwith the final hidden state), and pass the pooled vector through a small MLP to get **one scalar\nscore**. The same encoder/scorer weights are shared across all 5 candidates of a question\n(\"class-independent\" scoring) — the model produces `[score_A, ..., score_E]` and is trained with\ncross-entropy over the 5 options.","metadata":{}},{"id":"d4fc715a","cell_type":"code","source":"\nTOKEN_RE = re.compile(r\"[A-Za-z0-9]+(?:'[A-Za-z]+)?|[^\\sA-Za-z0-9]\")\n\ndef tokenize(text):\n    return TOKEN_RE.findall(text.lower())\n\nMAX_VOCAB_SIZE = 40000\nMIN_FREQ = 2\nMAX_LEN = 96\n\nPAD, UNK, SEP = '<pad>', '<unk>', '<sep>'\n\ndef build_vocab(df):\n    counter = Counter()\n    for _, row in df.iterrows():\n        counter.update(tokenize(row['prompt']))\n        for o in OPTS:\n            counter.update(tokenize(row[o]))\n    most_common = [w for w, c in counter.most_common(MAX_VOCAB_SIZE) if c >= MIN_FREQ]\n    itos = [PAD, UNK, SEP] + most_common\n    stoi = {w: i for i, w in enumerate(itos)}\n    return stoi, itos\n\nVOCAB, ITOS = build_vocab(tr_df)\nVOCAB_SIZE = len(ITOS)\nPAD_IDX, UNK_IDX, SEP_IDX = VOCAB[PAD], VOCAB[UNK], VOCAB[SEP]\nprint(\"Vocabulary size:\", VOCAB_SIZE)\n\ndef encode_pair(question, option, max_len=MAX_LEN):\n    q_tokens = tokenize(question)\n    o_tokens = tokenize(option)\n    tokens = q_tokens + [SEP] + o_tokens\n    tokens = tokens[:max_len]\n    ids = [VOCAB.get(t, UNK_IDX) for t in tokens]\n    length = len(ids)\n    if length < max_len:\n        ids = ids + [PAD_IDX] * (max_len - length)\n    return ids, length\n\nclass MCQRecurrentDataset(Dataset):\n    \n    def __init__(self, df, has_label=True):\n        self.prompts = df['prompt'].tolist()\n        self.options = [df[o].tolist() for o in OPTS]\n        self.has_label = has_label\n        if has_label:\n            self.labels = df['answer'].map(OPT2IDX).tolist()\n\n    def __len__(self):\n        return len(self.prompts)\n\n    def __getitem__(self, idx):\n        q = self.prompts[idx]\n        ids_list, len_list = [], []\n        for k in range(5):\n            ids, length = encode_pair(q, self.options[k][idx])\n            ids_list.append(ids)\n            len_list.append(length)\n        ids_t = torch.tensor(ids_list, dtype=torch.long)\n        len_t = torch.tensor(len_list, dtype=torch.long)\n        if self.has_label:\n            return ids_t, len_t, torch.tensor(self.labels[idx], dtype=torch.long)\n        return ids_t, len_t\n\ntrain_ds_rnn = MCQRecurrentDataset(tr_df, has_label=True)\nval_ds_rnn   = MCQRecurrentDataset(val_df, has_label=True)\ntest_ds_rnn  = MCQRecurrentDataset(test, has_label=False)\n\nRNN_BATCH_SIZE = 32\ntrain_loader_rnn = DataLoader(train_ds_rnn, batch_size=RNN_BATCH_SIZE, shuffle=True, drop_last=False)\nval_loader_rnn   = DataLoader(val_ds_rnn, batch_size=64, shuffle=False)\ntest_loader_rnn  = DataLoader(test_ds_rnn, batch_size=64, shuffle=False)\n\nprint(\"Train batches:\", len(train_loader_rnn), \"| Val batches:\", len(val_loader_rnn))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-10T06:58:51.407503Z","iopub.execute_input":"2026-08-10T06:58:51.407823Z","iopub.status.idle":"2026-08-10T06:58:51.641348Z","shell.execute_reply.started":"2026-08-10T06:58:51.407783Z","shell.execute_reply":"2026-08-10T06:58:51.640706Z"}},"outputs":[{"name":"stdout","text":"Vocabulary size: 2890\nTrain batches: 54 | Val batches: 5\n","output_type":"stream"}],"execution_count":25},{"id":"79787930","cell_type":"code","source":"\nclass RecurrentScorer(nn.Module):\n   \n    \n    def __init__(self, vocab_size, emb_dim=200, hidden_dim=192, rnn_type='lstm',\n                 num_layers=1, dropout=0.3, pad_idx=0):\n        super().__init__()\n        self.pad_idx = pad_idx\n        self.embedding = nn.Embedding(vocab_size, emb_dim, padding_idx=pad_idx)\n        self.emb_dropout = nn.Dropout(dropout)\n\n        rnn_cls = nn.LSTM if rnn_type == 'lstm' else nn.GRU\n        self.rnn = rnn_cls(\n            input_size=emb_dim, hidden_size=hidden_dim, num_layers=num_layers,\n            batch_first=True, bidirectional=True,\n            dropout=dropout if num_layers > 1 else 0.0,\n        )\n        self.rnn_type = rnn_type\n        enc_dim = hidden_dim * 2\n        pooled_dim = enc_dim * 2 + enc_dim\n\n        self.scorer = nn.Sequential(\n            nn.Linear(pooled_dim, hidden_dim), nn.ReLU(), nn.Dropout(dropout),\n            nn.Linear(hidden_dim, hidden_dim // 2), nn.ReLU(), nn.Dropout(dropout),\n            nn.Linear(hidden_dim // 2, 1),\n        )\n\n    def encode(self, ids, lengths):\n        emb = self.emb_dropout(self.embedding(ids))\n        lengths_clamped = lengths.clamp(min=1).cpu()\n        packed = pack_padded_sequence(emb, lengths_clamped, batch_first=True, enforce_sorted=False)\n        packed_out, hidden = self.rnn(packed)\n        outputs, _ = pad_packed_sequence(packed_out, batch_first=True, total_length=ids.size(1))\n\n        mask = (ids != self.pad_idx).unsqueeze(-1).float()\n        masked_out = outputs * mask\n        summed = masked_out.sum(1)\n        counts = mask.sum(1).clamp(min=1)\n        mean_pool = summed / counts\n\n        very_neg = torch.finfo(outputs.dtype).min\n        max_pool = masked_out.masked_fill(mask == 0, very_neg).max(1).values\n\n        if self.rnn_type == 'lstm':\n            h_n = hidden[0]\n        else:\n            h_n = hidden\n        h_last = torch.cat([h_n[-2], h_n[-1]], dim=-1)\n\n        pooled = torch.cat([mean_pool, max_pool, h_last], dim=-1)\n        return pooled\n\n    def forward(self, ids, lengths):\n        B, K, L = ids.shape\n        ids_flat = ids.reshape(B * K, L)\n        len_flat = lengths.reshape(B * K)\n        pooled = self.encode(ids_flat, len_flat)\n        scores = self.scorer(pooled).reshape(B, K)\n        return scores\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-10T06:58:51.642423Z","iopub.execute_input":"2026-08-10T06:58:51.642875Z","iopub.status.idle":"2026-08-10T06:58:51.655315Z","shell.execute_re