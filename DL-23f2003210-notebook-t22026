    "\n",
    "def map_at_3(scores, y_true):\n",
    "   \n",
    "    order = np.argsort(-scores, axis=1)[:, :3]\n",
    "    ap = 0.0\n",
    "    for i in range(len(y_true)):\n",
    "        preds = order[i]\n",
    "        hits = np.where(preds == y_true[i])[0]\n",
    "        if len(hits):\n",
    "            ap += 1.0 / (hits[0] + 1)\n",
    "    return ap / len(y_true)\n",
    "\n",
    "def top3_labels(scores):\n",
    "    order = np.argsort(-scores, axis=1)[:, :3]\n",
    "    return [' '.join(OPTS[j] for j in row) for row in order]\n"
   ]
