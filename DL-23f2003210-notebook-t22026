 Dataset\nfrom dataclasses import dataclass\nfrom transformers.tokenization_utils_base import PreTrainedTokenizerBase\nfrom typing import Union\n\nBERT_MODEL_NAME = \"bert-base-uncased\"\nBERT_MAX_LEN = 256\n\nrun_bert = wandb.init(project=WANDB_PROJECT, entity=WANDB_ENTITY, name=\"model3_bert\",\n                       job_type=\"train\", config={\n                           \"base_model\": BERT_MODEL_NAME, \"max_len\": BERT_MAX_LEN,\n                           \"epochs\": 5, \"lr\": 2e-5, \"batch_size\": 8,\n                           \"grad_accum_steps\": 2, \"warmup_ratio\": 0.1, \"weight_decay\": 0.01,\n                       }, reinit=True)\ncfg_bert = run_bert.config\n\nbert_tok = AutoTokenizer.from_pretrained(cfg_bert.base_model)\n\ndef to_mc_features(df, has_label=True):\n    first_sentences = [[p] * 5 for p in df['prompt']]\n    second_sentences = [[df.iloc[i][opt] for opt in OPTS] for i in range(len(df))]\n    first_sentences = sum(first_sentences, [])\n    second_sentences = sum(second_sentences, [])\n    tokenized = bert_tok(first_sentences, second_sentences, truncation=True,\n                          max_length=cfg_bert.max_len, padding=False)\n    features = {k: [v[i:i + 5] for i in range(0, len(v), 5)] for k, v in tokenized.items()}\n    if has_label:\n        features['labels'] = df['answer'].map(OPT2IDX).tolist()\n    return features\n\nbert_train_ds = Dataset.from_dict(to_mc_features(tr_df))\nbert_val_ds   = Dataset.from_dict(to_mc_features(val_df))\nbert_test_ds  = Dataset.from_dict(to_mc_features(test, has_label=False))\n\n@dataclass\nclass DataCollatorForMultipleChoice:\n    tokenizer: PreTrainedTokenizerBase\n    padding: Union[bool, str] = True\n\n    def __call__(self, features):\n        label_name = \"labels\" if \"labels\" in features[0] else None\n        labels = [f.pop(label_name) for f in features] if label_name else None\n        batch_size = len(features)\n        num_choices = len(features[0][\"input_ids\"])\n        flattened = [\n            {k: v[i] for k, v in f.items()} for f in features for i in range(num_choices)\n        ]\n        batch = self.tokenizer.pad(flattened, padding=self.padding, return_tensors=\"pt\")\n        batch = {k: v.view(batch_size, num_choices, -1) for k, v in batch.items()}\n        if labels is not None:\n            batch[\"labels\"] = torch.tensor(labels, dtype=torch.int64)\n        return batch\n\nbert_collator = DataCollatorForMultipleChoice(tokenizer=bert_tok)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-10T07:06:42.061554Z","iopub.execute_input":"2026-08-10T07:06:42.062227Z","iopub.status.idle":"2026-08-10T07:06:52.812883Z","shell.execute_reply.started":"2026-08-10T07:06:42.062197Z","shell.execute_reply":"2026-08-10T07:06:52.811976Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Tracking run with wandb version 0.28.1"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Run data is saved locally in <code>/kaggle/working/wandb/run-20260810_070642-z8ujdh8l</code>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"Syncing run <strong><a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026/runs/z8ujdh8l' target=\"_blank\">model3_bert</a></strong> to <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026' target=\"_blank\">Weights & Biases</a> (<a href='https://wandb.me/developer-guide' target=\"_blank\">docs</a>)<br>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":" View project at <a href='https://wandb.ai/23f2003210-indian-institute-of-technology-madras/23f2003210-t22026' targe