    "\n",
    "TOKEN_RE = re.compile(r\"[A-Za-z0-9]+(?:'[A-Za-z]+)?|[^\\sA-Za-z0-9]\")\n",
    "\n",
    "def tokenize(text):\n",
    "    return TOKEN_RE.findall(text.lower())\n",
    "\n",
    "MAX_VOCAB_SIZE = 40000\n",
    "MIN_FREQ = 2\n",
    "MAX_LEN = 96\n",
    "\n",
    "PAD, UNK, SEP = '<pad>', '<unk>', '<sep>'\n",
    "\n",
    "def build_vocab(df):\n",
    "    counter = Counter()\n",
    "    for _, row in df.iterrows():\n",
    "        counter.update(tokenize(row['prompt']))\n",
    "        for o in OPTS:\n",
    "            counter.update(tokenize(row[o]))\n",
    "    most_common = [w for w, c in counter.most_common(MAX_VOCAB_SIZE) if c >= MIN_FREQ]\n",
    "    itos = [PAD, UNK, SEP] + most_common\n",
    "    stoi = {w: i for i, w in enumerate(itos)}\n",
    "    return stoi, itos\n",
    "\n",
    "VOCAB, ITOS = build_vocab(tr_df)\n",
    "VOCAB_SIZE = len(ITOS)\n",
    "PAD_IDX, UNK_IDX, SEP_IDX = VOCAB[PAD], VOCAB[UNK], VOCAB[SEP]\n",
    "print(\"Vocabulary size:\", VOCAB_SIZE)\n",
    "\n",
    "def encode_pair(question, option, max_len=MAX_LEN):\n",
    "    q_tokens = tokenize(question)\n",
    "    o_tokens = tokenize(option)\n",
    "    tokens = q_tokens + [SEP] + o_tokens\n",
    "    tokens = tokens[:max_len]\n",
    "    ids = [VOCAB.get(t, UNK_IDX) for t in tokens]\n",
    "    length = len(ids)\n",
    "    if length < max_len:\n",
    "        ids = ids + [PAD_IDX] * (max_len - length)\n",
    "    return ids, length\n",
    "\n",
    "class MCQRecurrentDataset(Dataset):\n",
    "    '''Each item: (5, MAX_LEN) token ids + (5,) lengths + optional label.'''\n",
    "    def __init__(self, df, has_label=True):\n",
    "        self.prompts = df['prompt'].tolist()\n",
    "        self.options = [df[o].tolist() for o in OPTS]\n",
    "        self.has_label = has_label\n",
    "        if has_label:\n",
    "            self.labels = df['answer'].map(OPT2IDX).tolist()\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.prompts)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        q = self.prompts[idx]\n",
    "        ids_list, len_list = [], []\n",
    "        for k in range(5):\n",
    "            ids, length = encode_pair(q, self.options[k][idx])\n",
    "            ids_list.append(ids)\n",
    "            len_list.append(length)\n",
    "        ids_t = torch.tensor(ids_list, dtype=torch.long)\n",
    "        len_t = torch.tensor(len_list, dtype=torch.long)\n",
    "        if self.has_label:\n",
    "            return ids_t, len_t, torch.tensor(self.labels[idx], dtype=torch.long)\n",
    "        return ids_t, len_t\n",
    "\n",
